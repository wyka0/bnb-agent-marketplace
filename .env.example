# Names and placeholders only. Never commit real values.
# Classification: PUBLIC = safe for browser | SERVER = server-only config
# SECRET = server-only credential | CUSTODY = key custody reference

# --- SERVER: 8004scan (never NEXT_PUBLIC_) ---
8004SCAN_API_KEY=

# --- SECRET: PostgreSQL (pooled runtime + direct migration) ---
DATABASE_URL=
DIRECT_DATABASE_URL=

# --- SERVER: authentication ---
AUTH_CANONICAL_ORIGIN=
AUTH_SESSION_TTL_SECONDS=604800

# --- SERVER: rate limiting. Production requires `prisma` (cross-instance). ---
# memory = per-instance only (development / single instance)
RATE_LIMIT_BACKEND=memory

# --- SECRET/CUSTODY: AWS KMS envelope custody (server-side only) ---
AWS_REGION=
ALTANA_KMS_KEY_ID=
ALTANA_KMS_PROVIDER=aws

# --- SERVER: Altana testnet (chain 97 only) ---
ALTANA_NETWORK=bnb-testnet
ALTANA_PAYTO=
ALTANA_FACILITATOR_ADDRESS=
ALTANA_OPERATOR_ADDRESS=
ALTANA_SERVICE_PRICE_RAW_U=
ALTANA_RPC_URL=

# --- CUSTODY: long-lived Altana admin/provider key.
# PRODUCTION MUST use a remote signer / HSM reference.
# ALTANA_TESTNET_PRIVATE_KEY is a LOCAL-ONLY development fallback and is
# REJECTED by the production configuration assertion.
ALTANA_ADMIN_CUSTODY_PROVIDER=
ALTANA_ADMIN_KEY_REFERENCE=
ALTANA_TESTNET_PRIVATE_KEY=

# --- SERVER: unrelated integrations (local/testnet only) ---
FACILITATOR_KEY=
MERCHANT_PAYTO=
PANCAKESWAP_API_KEY=
X402_PAYTO=
