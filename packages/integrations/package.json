{
  "name": "@bnb-marketplace/integrations",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./altana": {
      "types": "./dist/altana/index.d.ts",
      "default": "./dist/altana/index.js"
    },
    "./termix": {
      "types": "./dist/termix/index.d.ts",
      "default": "./dist/termix/index.js"
    },
    "./pancakeswap": {
      "types": "./dist/pancakeswap/index.d.ts",
      "default": "./dist/pancakeswap/index.js"
    },
    "./studio": {
      "types": "./dist/studio/index.d.ts",
      "default": "./dist/studio/index.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node dist/altana/session.verify.js",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
